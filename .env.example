# Copy this file to .env and fill in real values.

# ArmorIQ — from `armoriq login` / the platform dashboard. Must start with
# ak_live_, ak_test_, or ak_claw_.
ARMORIQ_API_KEY=

# production / staging / local — leave unset to use the platform default.
ARMORIQ_ENV=

# AGENT_EMAIL is the identity the agent runs as — any email works, it does
# NOT need to be a registered platform member (an unregistered email resolves
# to least-privileged automatically, confirmed live). APPROVER_EMAIL MUST be
# a real, higher-ranked member of your ArmorIQ org (e.g. its org_admin) so it
# can approve held plans from the dashboard — a requester can never approve
# its own request.
AGENT_EMAIL=agent-operator@example.com
APPROVER_EMAIL=approver@example.com

# LLM tool-calling loop. Free-tier default confirmed live to support tool
# calling on OpenRouter; override if it stops being free/available.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
