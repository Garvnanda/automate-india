# Copy this file to .env and fill in real values.

# ArmorIQ — from `armoriq login` / the platform dashboard. Must start with
# ak_live_, ak_test_, or ak_claw_.
ARMORIQ_API_KEY=

# production / staging / local — leave unset to use the platform default.
ARMORIQ_ENV=

# Two distinct platform identities. AGENT_EMAIL is the low-ranked identity the
# agent runs as; APPROVER_EMAIL is the higher-ranked identity that approves
# held plans from the dashboard. A requester can never approve their own
# request, so these must be different accounts with different roles.
AGENT_EMAIL=agent-operator@example.com
APPROVER_EMAIL=approver@example.com

# LLM tool-calling loop.
OPENROUTER_API_KEY=
